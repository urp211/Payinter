# ---- PayInter backend configuration ----
# Core
NODE_ENV=development
PORT=4000
# DEMO_MODE keeps sandbox providers + labels. live money requires DEMO_MODE=false AND real provider credentials below.
DEMO_MODE=true
SANDBOX_PROVIDERS=true

# Database: leave empty to use embedded PGlite (zero-infra dev + tests)
DATABASE_URL=
DB_EMBEDDED_PATH=.data/payinter.pglite
MIGRATIONS_DIR=../database/migrations

# Secrets (NEVER commit real values)
JWT_SECRET=change_me_32+_hex_chars
JWT_REFRESH_SECRET=change_me_refresh_32+_hex
PIN_PEPPER=change_me_pin_pepper
QR_SIGNING_SECRET=change_me_qr_hmac
DATA_ENCRYPTION_KEY=change_me_data_key

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# OTP
OTP_TTL_SECONDS=600
DEMO_OTP=123456

# CORS (comma separated). *.e2b.app previews are always allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Providers (live mode only; sandbox ignores these)
CARD_PROCESSOR=sandbox
CARD_PROCESSOR_API_KEY=
CARD_PROCESSOR_WEBHOOK_SECRET=
INTL_PROVIDER=sandbox
INTL_PROVIDER_API_KEY=
FX_PROVIDER=sandbox
FX_PROVIDER_URL=
FX_PROVIDER_API_KEY=

# Fraud rules
FRAUD_VELOCITY_WINDOW_SECONDS=600
FRAUD_VELOCITY_MAX_TXNS=5
FRAUD_LARGE_AMOUNT_MINOR=500000

# Seed demo data (creates demo@payinter.app / Demo1234! & admin@payinter.app)
SEED_DEMO_DATA=true
